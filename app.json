{
  "expo": {
    "name": "EcoSort",
    "slug": "ecosort-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ecosort",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D84A4A",
          "defaultChannel": "ecosort-full-bin",
          "sounds": ["./assets/full-bin-alarm.wav"]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.ncku.ecosort"
    },
    "android": {
      "package": "edu.ncku.ecosort",
      "permissions": ["VIBRATE", "POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#E9F2EC"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
